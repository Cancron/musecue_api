DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/musecue

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=musecue

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

DATABASE_PORT=5433
DATABASE_HOST=127.0.0.1

NODE_ENV=development

PORT=5000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Private face-image storage (filesystem path for local/self-hosted deployments)
PRIVATE_UPLOAD_DIR=.data/private-images

# AI provider. Use mock for deterministic/offline UI development.
AI_MODE=live
OPENROUTER_API_KEY=replace-with-a-new-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Optional per-operation overrides:
# OPENROUTER_ANALYSIS_MODEL=openrouter/free
# OPENROUTER_GUIDE_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=openrouter/free
# OPENROUTER_QUESTION_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_APP_NAME=MuseCue
# Optional comma-separated model fallbacks for capacity/provider failures:
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,openai/gpt-4.1-mini
# Optional provider ordering: price, throughput, or latency
# OPENROUTER_PROVIDER_SORT=throughput
# Per-operation latency/cost budgets override the general values above:
OPENROUTER_ANALYSIS_TIMEOUT_MS=60000
OPENROUTER_GUIDE_TIMEOUT_MS=90000
OPENROUTER_VISION_TIMEOUT_MS=30000
OPENROUTER_QUESTION_TIMEOUT_MS=20000
OPENROUTER_ANALYSIS_MAX_TOKENS=4000
OPENROUTER_GUIDE_MAX_TOKENS=8000
# Optional: only for a pinned model/provider supporting reasoning effort.
# OPENROUTER_GUIDE_REASONING_EFFORT=low
OPENROUTER_VISION_MAX_TOKENS=600
OPENROUTER_QUESTION_MAX_TOKENS=500
OPENROUTER_IMAGE_MAX_BYTES=1500000
OPENROUTER_IMAGE_MAX_EDGE=1600
OPENROUTER_IMAGE_QUALITY=82
OPENROUTER_MAX_RESPONSE_BYTES=1000000
# Optional application URL used for OpenRouter attribution:
# OPENROUTER_SITE_URL=https://your-app.example
# Set to deny for stricter provider data policy. This can reduce free-model availability.
# OPENROUTER_DATA_COLLECTION=deny

# Distributed AI queue backpressure (shared across all API/worker instances)
AI_QUEUE_GLOBAL_CONCURRENCY=4
AI_QUEUE_RATE_LIMIT_MAX=15
AI_QUEUE_RATE_LIMIT_DURATION_MS=60000
AI_QUEUE_MAX_BACKLOG=1000
# Provider 429 responses above this delay fail fast instead of freezing the queue.
AI_QUEUE_MAX_PROVIDER_PAUSE_MS=120000
# Short provider rate limits may defer a job this many times before it fails.
AI_QUEUE_MAX_RATE_LIMIT_DEFERRALS=2
# Orphaned run recovery grace period, minimum 120000 ms; checked every 30 s.
AI_JOB_RECOVERY_GRACE_MS=120000

JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-at-least-256-bits-long
JWT_REFRESH_SECRET=replace-with-a-different-strong-refresh-secret-at-least-256-bits-long

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_CACHE_KEY_PREFIX=musecue

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="MuseCue <noreply@example.com>"

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

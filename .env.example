DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/musecue

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=musecue

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

DATABASE_PORT=5433
DATABASE_HOST=127.0.0.1

NODE_ENV=development

PORT=5000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Private face-image storage (filesystem path for local/self-hosted deployments)
PRIVATE_UPLOAD_DIR=.data/private-images

JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-at-least-256-bits-long
JWT_REFRESH_SECRET=replace-with-a-different-strong-refresh-secret-at-least-256-bits-long

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_CACHE_KEY_PREFIX=musecue

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="MuseCue <noreply@example.com>"

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

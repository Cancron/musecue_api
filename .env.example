DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/musecue
# Optional: enables the real-PostgreSQL subscription-plan tests. Tests create and
# drop their own temporary schemas; prefer a separate database from DATABASE_URL.
# TEST_DATABASE_URL=postgresql://admin:admin@127.0.0.1:5433/musecue_test

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=musecue

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

DATABASE_PORT=5433
DATABASE_HOST=127.0.0.1

NODE_ENV=development

PORT=5000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Private image storage (face photos, step snapshots, avatars).
# New uploads go to PRIVATE_STORAGE_PROVIDER: the id of a registered provider,
# "supabase" (default) or "local" for offline development. Existing images are always
# read, signed and deleted through the provider recorded with them, so keep every
# provider that stored images configured after changing this. Test runs
# (NODE_ENV=test) default to "local" unless this is set.
PRIVATE_STORAGE_PROVIDER=local
# Supabase Storage: server-side only. Never ship these to the mobile app. The bucket
# must be PRIVATE; uploads are refused if it is public. Use the secret/service_role
# key (publishable and anon keys are rejected at startup).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Optional per-request timeout in ms (1000-120000, default 15000):
# SUPABASE_STORAGE_TIMEOUT_MS=15000
# Filesystem root for the "local" provider and for images stored before the move to Supabase
PRIVATE_UPLOAD_DIR=.data/private-images

# Personal data export archives (separate private root; never publicly served)
PRIVATE_EXPORT_DIR=.data/private-exports
# Waiting/active export jobs accepted before new requests receive 503.
PRIVACY_EXPORT_MAX_BACKLOG=500
# Stale exports whose job is missing or finished are failed after this grace
# period (minimum 120000 ms); checked every 60 s.
PRIVACY_EXPORT_RECOVERY_GRACE_MS=120000
# Retention sweep: expires archives 24 hours after export, deletes their files
# and retries failed cleanups (default 60000 ms, minimum 10000). A storage scan
# for files without a record (e.g. after account deletion) runs at most every
# PRIVACY_EXPORT_ORPHAN_SCAN_INTERVAL_MS (default 3600000 ms).
PRIVACY_EXPORT_CLEANUP_INTERVAL_MS=60000
PRIVACY_EXPORT_ORPHAN_SCAN_INTERVAL_MS=3600000
# Export workers hold a renewable lease while they build an archive; account
# erasure waits until no worker of the account holds one. Optional overrides:
# PRIVACY_EXPORT_WORKER_LEASE_MS=60000
# PRIVACY_EXPORT_WORKER_HEARTBEAT_MS=15000
# Signed export download links: lifetime in seconds (60-900; never more than
# 15 minutes) and an optional dedicated HMAC key (at least 32 characters).
# Without the key, a purpose-bound key is derived from JWT_ACCESS_SECRET.
# Rotating the key invalidates links that were already issued.
PRIVACY_EXPORT_DOWNLOAD_TTL_SECONDS=900
# PRIVACY_EXPORT_DOWNLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# AI provider. Use mock for deterministic/offline UI development.
AI_MODE=live
OPENROUTER_API_KEY=replace-with-a-new-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Optional per-operation overrides:
# OPENROUTER_ANALYSIS_MODEL=openrouter/free
# OPENROUTER_GUIDE_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=openrouter/free
# OPENROUTER_QUESTION_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_APP_NAME=MuseCue
# Optional comma-separated model fallbacks for capacity/provider failures:
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,openai/gpt-4.1-mini
# Optional provider ordering: price, throughput, or latency
# OPENROUTER_PROVIDER_SORT=throughput
# Per-operation latency/cost budgets override the general values above:
OPENROUTER_ANALYSIS_TIMEOUT_MS=60000
OPENROUTER_GUIDE_TIMEOUT_MS=90000
OPENROUTER_VISION_TIMEOUT_MS=30000
OPENROUTER_QUESTION_TIMEOUT_MS=20000
OPENROUTER_ANALYSIS_MAX_TOKENS=4000
OPENROUTER_GUIDE_MAX_TOKENS=8000
# Optional: only for a pinned model/provider supporting reasoning effort.
# OPENROUTER_GUIDE_REASONING_EFFORT=low
OPENROUTER_VISION_MAX_TOKENS=4000
OPENROUTER_QUESTION_MAX_TOKENS=500
OPENROUTER_IMAGE_MAX_BYTES=1500000
OPENROUTER_IMAGE_MAX_EDGE=1600
OPENROUTER_IMAGE_QUALITY=82
OPENROUTER_MAX_RESPONSE_BYTES=1000000
# Optional application URL used for OpenRouter attribution:
# OPENROUTER_SITE_URL=https://your-app.example
# Set to deny for stricter provider data policy. This can reduce free-model availability.
# OPENROUTER_DATA_COLLECTION=deny

# Distributed AI queue backpressure (shared across all API/worker instances)
AI_QUEUE_GLOBAL_CONCURRENCY=4
AI_QUEUE_RATE_LIMIT_MAX=15
AI_QUEUE_RATE_LIMIT_DURATION_MS=60000
AI_QUEUE_MAX_BACKLOG=1000
# Provider 429 responses above this delay fail fast instead of freezing the queue.
AI_QUEUE_MAX_PROVIDER_PAUSE_MS=120000
# Short provider rate limits may defer a job this many times before it fails.
AI_QUEUE_MAX_RATE_LIMIT_DEFERRALS=2
# Orphaned run recovery grace period, minimum 120000 ms; checked every 30 s.
AI_JOB_RECOVERY_GRACE_MS=120000

JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-at-least-256-bits-long
JWT_REFRESH_SECRET=replace-with-a-different-strong-refresh-secret-at-least-256-bits-long

# MFA (optional authenticator-app MFA, recovery codes, trusted devices).
# Dedicated key for authenticator secrets: 32 random bytes as base64 or 64 hex
# characters, e.g. `openssl rand -base64 32`. It is independent of the JWT
# secrets (rotating those never affects MFA) and must differ from them. Keep it
# as secret as the database credentials and never change it casually: to
# rotate, put the current value in MFA_ENCRYPTION_PREVIOUS_KEYS and set a new
# one (secrets move to the new key as they are used). Without it, enrolling and
# authenticator codes answer 503 (recovery codes and trusted devices still work).
# An invalid value stops the API at startup.
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Comma-separated older keys, only used to read secrets written before a rotation:
# MFA_ENCRYPTION_PREVIOUS_KEYS=
# Only for the one-time `npm run mfa:rekey` after upgrading from the first MFA
# build: the JWT_REFRESH_SECRET value its secrets were written with (defaults
# to JWT_REFRESH_SECRET). Not read by the API.
# MFA_LEGACY_JWT_REFRESH_SECRET=

# Optional SMS sign-in codes for users with authenticator MFA (phone numbers
# are encrypted with MFA_ENCRYPTION_KEY). `none` (default) disables SMS;
# `twilio` sends through Twilio's Messages API with the settings below
# (TWILIO_FROM: a Twilio number in E.164 form or a Messaging Service SID, MG...).
SMS_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Stripe payments for the Pro plan. Leave the keys empty to disable checkout
# (POST /v1/subscription/checkout then returns 503). Use test-mode keys locally.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /v1/webhooks/stripe (or from `stripe listen`).
# Subscribe it to: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, invoice.paid,
# invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted,
# charge.refunded, charge.refund.updated, refund.created, refund.updated, refund.failed
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the browser (absolute http(s) URLs). These pages never
# activate Pro; only the verified webhook does.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:8081/checkout/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:8081/checkout/cancel
# Optional existing Stripe product for Pro. Prices always come from the plan settings.
# STRIPE_PRO_PRODUCT_ID=prod_replace-me
# Minutes a hosted checkout stays payable (31-1440).
STRIPE_CHECKOUT_EXPIRES_MINUTES=60

# Infrastructure mode, fixed at startup (PostgreSQL is required in both modes):
# - true (default when omitted): BullMQ queues, Redis rate limiting and the
#   Redis token-version cache; the REDIS_* settings below are used.
# - false: PostgreSQL queues (worker inside the API process, one API instance),
#   PostgreSQL rate limiting, no Redis connection; REDIS_* settings are ignored
#   and JWT_REFRESH_SECRET is required (it keys the encrypted job payloads).
# Any other value stops the API at startup. Switching is a maintenance
# operation: only switch while the current queue has no pending jobs (see
# README "Infrastructure mode").
REDIS_ENABLED=true

# Redis Configuration (only used when REDIS_ENABLED=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your_redis_password
REDIS_CACHE_KEY_PREFIX=musecue

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="MuseCue <noreply@example.com>"

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Optional: where Google returns step-up reauthentications of Google-only
# accounts (POST /auth/step-up/google). Must be a URL of the client (app deep
# link or web page), which posts the `code` and `state` to
# POST /auth/step-up/google/callback with its access token. Register it in the
# Google console. Defaults to GOOGLE_REDIRECT_URI.
# GOOGLE_STEP_UP_REDIRECT_URI=musecue://auth/step-up

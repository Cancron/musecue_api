// ================================
// Subscription Plan Configuration
// ================================

// One row per plan, keyed by its code. MuseCue currently sells a single Pro
// plan, so the only row is `PRO`. Prices are integer US cents to avoid
// floating-point rounding. Defaults must match SUBSCRIPTION_PLAN_DEFAULTS in
// src/subscription/subscription-plan.constants.ts.
model SubscriptionPlan {
  code                 PlanCode @id
  planEnabled          Boolean  @default(true)
  monthlyPriceUsdCents Int      @default(1900)
  yearlyPriceUsdCents  Int      @default(19000)
  trialEnabled         Boolean  @default(true)
  trialDays            Int      @default(7)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// One subscription record per user, created when the user first starts a
// trial or buys Pro (a user without a record is FREE). The free trial and the
// paid Pro subscription are tracked separately on the same record: the trial
// fields are written once, while the Pro fields describe the current or most
// recent paid term and are replaced on renewal or repurchase. Pro fields are
// never cleared: a non-null proStartedAt is the record of paid-Pro history
// that makes the user ineligible for the free trial. A paid term can only be
// created or extended when one SUCCEEDED PaymentTransaction of this
// subscription covers the newly granted range and ends at proExpiresAt
// (database trigger): a new term may not start before its paid period and a
// renewal may not bridge an unpaid gap. Pending, failed or refunded payments
// never grant or renew Pro access.
//
// Pro access is derived from the date windows by
// src/subscription/subscription-access.policy.ts; `status` is a stored
// snapshot for reporting and must not be used on its own to grant access.
// Consistency rules are enforced by CHECK constraints in the migration.
model UserSubscription {
  id     String             @id @default(uuid())
  authId String             @unique
  status SubscriptionStatus @default(FREE)

  // Free trial (usable once)
  trialUsed      Boolean   @default(false)
  trialStartedAt DateTime?
  trialExpiresAt DateTime?

  // Paid Pro subscription (renewable)
  billingInterval BillingInterval?
  proStartedAt    DateTime?
  proExpiresAt    DateTime?
  // Set when the user cancels: no renewal, access continues until proExpiresAt.
  proCanceledAt   DateTime?

  // Link to the payment provider's recurring subscription (set by checkout).
  paymentProvider        String?   @db.VarChar(50)
  providerSubscriptionId String?   @db.VarChar(255)
  // Set when a renewal of the linked provider subscription failed and is
  // still being retried; cleared once a payment is collected or the provider
  // subscription ends. Never changes the paid term.
  pastDueSince           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authUser         authUser             @relation(fields: [authId], references: [id], onDelete: Cascade)
  payments         PaymentTransaction[]
  events           SubscriptionEvent[]
  checkoutSessions CheckoutSession[]

  @@unique([paymentProvider, providerSubscriptionId])
  @@index([status])
}

// One charge attempt for one billing period of the Pro plan. Payments are
// financial records: they are never deleted, their amount, currency, provider
// IDs and period never change, and their status only moves forward
// (PENDING -> SUCCEEDED | FAILED; SUCCEEDED -> PARTIALLY_REFUNDED | REFUNDED).
// Only a SUCCEEDED payment can create or extend a paid term on
// UserSubscription (enforced by a database trigger).
//
// When an account is deleted, its subscription is deleted and its payments
// are kept, detached: subscriptionId becomes NULL (ON DELETE SET NULL). That
// is the only change the database allows to subscriptionId, and only once the
// subscription no longer exists; a payment is never re-attached.
model PaymentTransaction {
  id                  String          @id @default(uuid())
  subscriptionId      String?
  provider            String          @db.VarChar(50)
  providerPaymentId   String          @db.VarChar(255)
  // The provider invoice this attempt tried to collect (Stripe `in_...`).
  // A failed attempt and the later successful one share it.
  providerInvoiceId   String?         @db.VarChar(255)
  status              PaymentStatus   @default(PENDING)
  amountCents         Int
  currency            String          @default("USD") @db.Char(3)
  billingInterval     BillingInterval
  periodStart         DateTime
  periodEnd           DateTime
  paidAt              DateTime?
  failedAt            DateTime?
  failureCode         String?         @db.VarChar(100)
  failureMessage      String?         @db.VarChar(500)
  refundedAmountCents Int             @default(0)
  refundedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  subscription UserSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  event           SubscriptionEvent?
  // Monthly Pro credits paid for by this payment (see CreditAllocation),
  // and the months they are scheduled for (CreditAllocationSchedule).
  creditAllocations CreditAllocation[]
  creditSchedule    CreditAllocationSchedule[]
  checkoutSession CheckoutSession?
  refunds         PaymentRefund[]
  // The checkout discount this payment redeemed (at most one).
  discountRedemptions DiscountRedemption[]

  @@unique([provider, providerPaymentId])
  @@index([subscriptionId, createdAt])
  @@index([status])
  @@index([provider, providerInvoiceId])
}

// Append-only lifecycle log of a subscription. CREATED and RENEWED events
// reference the SUCCEEDED payment that paid for the period (one event per
// payment); other events have no payment.
// A cancellation is logged once: at most one CANCELED event per subscription
// and cancellation time (partial unique index, migration
// 20261116120000_subscription_cancellation).
model SubscriptionEvent {
  id             String                @id @default(uuid())
  subscriptionId String
  type           SubscriptionEventType
  paymentId      String?               @unique
  occurredAt     DateTime
  createdAt      DateTime              @default(now())

  subscription UserSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment      PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, occurredAt])
}

// The user's customer record at a payment provider (e.g. Stripe `cus_...`).
// Every user has their own customer: one per user and provider, and a
// provider customer belongs to exactly one user.
model PaymentCustomer {
  id                 String   @id @default(uuid())
  authId             String
  provider           String   @db.VarChar(50)
  providerCustomerId String   @db.VarChar(255)
  createdAt          DateTime @default(now())

  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([authId, provider])
  @@unique([provider, providerCustomerId])
}

// One hosted checkout for the Pro plan. The price and interval are fixed when
// the checkout is created from the backend plan configuration; the provider
// session is created with an idempotency key derived from `id`, so retries
// and concurrent requests resolve to the same provider session.
//
// A subscription has at most one pending checkout (CREATING, OPEN or
// PROCESSING; partial unique index in the migration). A checkout never grants
// access on its own: only a verified provider webhook records a SUCCEEDED
// PaymentTransaction, links it here and moves the checkout to COMPLETED.
// Status only moves forward and the price, interval, customer and provider
// session never change (database trigger).
model CheckoutSession {
  id                     String                @id @default(uuid())
  subscriptionId         String
  provider               String                @db.VarChar(50)
  providerSessionId      String?               @db.VarChar(255)
  providerCustomerId     String                @db.VarChar(255)
  providerSubscriptionId String?               @db.VarChar(255)
  status                 CheckoutSessionStatus @default(CREATING)
  billingInterval        BillingInterval
  amountCents            Int
  currency               String                @default("USD") @db.Char(3)
  // Hosted payment page; only returned while the checkout is OPEN.
  url                    String?
  expiresAt              DateTime
  completedAt            DateTime?
  // Set when the checkout becomes EXPIRED or FAILED, with a short code
  // explaining why (e.g. REPLACED, PROVIDER_EXPIRED, ASYNC_PAYMENT_FAILED).
  closedAt               DateTime?
  closedReason           String?               @db.VarChar(100)
  paymentId              String?               @unique
  // The discount applied to the first payment (the best one available when
  // the checkout was created), fixed with the checkout: the first charge is
  // amountCents - discountCents (a one-time Stripe coupon); renewals are
  // charged amountCents. `requestedDiscountCode` is the code the user
  // entered, if any (a repeated request with another code replaces the
  // checkout). Never changes (database trigger).
  discountSource         DiscountSource?
  discountOfferId        String?
  discountPercent        Int                   @default(0)
  discountCents          Int                   @default(0)
  requestedDiscountCode  String?               @db.VarChar(32)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  subscription        UserSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment             PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  discountOffer       DiscountOffer?      @relation(fields: [discountOfferId], references: [id], onDelete: Restrict)
  discountRedemption  DiscountRedemption?

  @@unique([provider, providerSessionId])
  @@index([subscriptionId, createdAt])
  @@index([status, expiresAt])
}

// One refund of a collected payment at the provider (Stripe `re_...`), full
// or partial, as confirmed by the provider. Only SUCCEEDED refunds count
// towards PaymentTransaction.refundedAmountCents. Refund facts never change,
// the status only moves forward, succeeded refunds never exceed the payment
// and rows are never deleted (database trigger).
model PaymentRefund {
  id                String       @id @default(uuid())
  paymentId         String
  provider          String       @db.VarChar(50)
  providerRefundId  String       @db.VarChar(255)
  providerChargeId  String       @db.VarChar(255)
  status            RefundStatus
  amountCents       Int
  currency          String       @default("USD") @db.Char(3)
  reason            String?      @db.VarChar(100)
  // When the refund was created at the provider.
  providerCreatedAt DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@index([paymentId])
}

// A provider webhook event whose signature was verified (e.g. Stripe
// `evt_...`): written before processing, updated with the outcome, so a
// verified event that could not be applied stays visible as FAILED until a
// redelivery processes it. Stores no payload.
model PaymentWebhookEvent {
  id              String             @id @default(uuid())
  provider        String             @db.VarChar(50)
  providerEventId String             @db.VarChar(255)
  type            String             @db.VarChar(100)
  // The object the event is about (e.g. a checkout session or invoice id).
  objectId        String?            @db.VarChar(255)
  livemode        Boolean
  eventCreatedAt  DateTime
  status          WebhookEventStatus @default(RECEIVED)
  // What processing did (e.g. ACTIVATED, ALREADY_PROCESSED, IGNORED).
  outcome         String?            @db.VarChar(50)
  // Deliveries received, including redeliveries of the same event.
  attempts        Int                @default(1)
  // Class or code of the last failure; never a message or payload.
  lastErrorCode   String?            @db.VarChar(100)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  updatedAt       DateTime           @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

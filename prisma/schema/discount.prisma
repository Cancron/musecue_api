// ================================
// Discount Codes and Campaigns
// ================================
//
// Administrator-managed discount offers and their redemptions. A redemption
// prices one credit package (CreditPackage) with the offer's discount and
// counts towards the offer's limits. Rules Prisma cannot express (CHECK
// constraints, the redemption trigger that enforces every limit under a
// lock of the offer row) are in migration 20261202120000_add_discount_offers.

// A discount code (kind CODE, with a unique upper-case `code`) or a
// promotional campaign (kind CAMPAIGN, no code). An offer is redeemable
// while it is active with a discount above 0%, within [startsAt, endsAt),
// for an eligible user below `maxRedemptionsPerUser`, and while fewer than
// `maxTotalRedemptions` (NULL = unlimited) redemptions have been made.
// Offers are deactivated, never deleted.
model DiscountOffer {
  id                    String            @id @default(uuid())
  kind                  DiscountOfferKind
  // CODE only: upper case, 3-32 of A-Z, 0-9, "_" and "-"; unique.
  code                  String?           @unique @db.VarChar(32)
  name                  String            @db.VarChar(100)
  // 0-100; 0 switches the offer off like active = false.
  discountPercent       Int
  active                Boolean           @default(true)
  startsAt              DateTime
  endsAt                DateTime
  audience              DiscountAudience  @default(ALL_USERS)
  maxRedemptionsPerUser Int               @default(1)
  maxTotalRedemptions   Int?
  // Redemptions counted towards maxTotalRedemptions: RESERVED (held by an
  // unpaid checkout) and REDEEMED ones, including redemptions of deleted
  // accounts (a depleted offer stays depleted); `reservedCount` of them are
  // RESERVED. Maintained by the redemption trigger only.
  redemptionCount       Int               @default(0)
  reservedCount         Int               @default(0)
  // Campaign controls. The list price of the product must be at least
  // `minSpendCents`; `eligibleProducts` empty = every product.
  minSpendCents         Int                         @default(0)
  customerEligibility   DiscountCustomerEligibility @default(ALL_CUSTOMERS)
  eligibleProducts      DiscountProduct[]           @default([])
  // USD budget for the discounts granted, in cents (NULL = unlimited):
  // spent (REDEEMED) + reserved (RESERVED) never exceeds it. Maintained by
  // the redemption trigger only.
  budgetCents           Int?
  budgetSpentCents      Int                         @default(0)
  budgetReservedCents   Int                         @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  targets     DiscountOfferTarget[]
  redemptions DiscountRedemption[]
  checkouts   CheckoutSession[]

  @@index([kind, createdAt])
}

// The users a SELECTED_USERS offer is for.
model DiscountOfferTarget {
  offerId   String
  authId    String
  createdAt DateTime @default(now())

  offer    DiscountOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  authUser authUser      @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@id([offerId, authId])
  @@index([authId])
}

// One use of a discount by a user, with the price terms fixed when it was
// made: a checkout's discount (RESERVED with the checkout, REDEEMED when its
// payment is recorded, RELEASED when the checkout can no longer be paid), or
// a discount code or campaign redeemed for a credit package (REDEEMED at
// once). Unique per user and idempotency key, so a retried or duplicated
// request is stored once; a user uses the first-purchase and the referral
// discount at most once (partial unique index). Only the status moves (and
// only forward, or RELEASED -> REDEEMED for a late payment); nothing else
// changes (database trigger).
model DiscountRedemption {
  id                    String                   @id @default(uuid())
  // CODE and CAMPAIGN only.
  offerId               String?
  authId                String
  source                DiscountSource
  status                DiscountRedemptionStatus @default(REDEEMED)
  idempotencyKey        String                   @db.VarChar(200)
  product               DiscountProduct
  // Credit packages only.
  packageCode           CreditPackageCode?
  credits               Int?
  discountPercent       Int
  originalPriceUsdCents Int
  discountUsdCents      Int
  finalPriceUsdCents    Int
  // The checkout the discount was reserved for, and the payment that
  // redeemed it.
  checkoutSessionId     String?                  @unique
  paymentId             String?
  reservedAt            DateTime?
  redeemedAt            DateTime?
  releasedAt            DateTime?
  releaseReason         String?                  @db.VarChar(50)
  createdAt             DateTime                 @default(now())

  offer    DiscountOffer?      @relation(fields: [offerId], references: [id], onDelete: Restrict)
  authUser authUser            @relation(fields: [authId], references: [id], onDelete: Cascade)
  checkout CheckoutSession?    @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  payment  PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([authId, idempotencyKey])
  @@index([offerId, authId])
  @@index([authId, source])
}

// ================================
// Referrals
// ================================

// A user's own referral code, created on first use.
model ReferralCode {
  authId    String   @id
  // Upper case letters and digits; unique.
  code      String   @unique @db.VarChar(16)
  createdAt DateTime @default(now())

  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)
}

// The user (`authId`) signed up with another user's referral code. Recorded
// only at signup, in the transaction that creates the account (never for an
// existing account), once per person: `canonicalEmailHash` (SHA-256 of the
// email, lower case, without "+tags" and, for Gmail, without dots) is
// unique, and is compared with the referrer's to refuse self-referrals.
//
// PENDING until the referred user's first verified paying purchase
// (a SUCCEEDED Stripe payment above $0): then REWARDED, with the referrer's
// non-expiring REFERRAL credits granted in the same transaction (once:
// conditional status change and a unique credit reference), or QUALIFIED
// when no reward was due (reward switched off, referrer deleted). The
// referred user keeps the referral if the referrer's account is deleted.
model Referral {
  id                  String         @id @default(uuid())
  authId              String         @unique
  referrerAuthId      String?
  // The code used at signup.
  referralCode        String?        @db.VarChar(16)
  // NULL only for referrals recorded before signup-time registration.
  canonicalEmailHash  String?        @unique @db.Char(64)
  status              ReferralStatus @default(PENDING)
  qualifyingPaymentId String?        @unique
  qualifiedAt         DateTime?
  rewardCredits       Int?
  rewardedAt          DateTime?
  createdAt           DateTime       @default(now())

  authUser          authUser            @relation("ReferralReferred", fields: [authId], references: [id], onDelete: Cascade)
  referrer          authUser?           @relation("ReferralReferrer", fields: [referrerAuthId], references: [id], onDelete: SetNull)
  qualifyingPayment PaymentTransaction? @relation(fields: [qualifyingPaymentId], references: [id], onDelete: Restrict)

  @@index([referrerAuthId, createdAt])
}

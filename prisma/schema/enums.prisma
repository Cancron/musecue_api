// ================================
// User & Auth Related Enums
// ================================

enum userRole {
  USER
  ADMIN
  MODERATOR
  SUPERADMIN
}

enum userStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  BLOCKED
  // The owner asked for permanent deletion; the account is locked out.
  PENDING_DELETION
}

enum mfaMethod {
  totp
  sms
  email
  webauthn
}

// Why a refresh session stopped working.
enum RefreshSessionRevocation {
  // Replaced by rotation (POST /auth/refresh-token).
  ROTATED
  LOGOUT
  LOGOUT_ALL
  // Oldest session removed when a new login exceeded the device limit.
  DEVICE_LIMIT
  // A token whose hash did not match was presented for the session's user.
  REUSE_DETECTED
  // The account is no longer active.
  ACCOUNT_INACTIVE
  // A security event (e.g. account deletion) revoked every session.
  SECURITY_EVENT
}

enum AuthChallengePurpose {
  EMAIL_VERIFICATION
  ACCOUNT_DELETION
}

enum loginAction {
  login
  logout
}


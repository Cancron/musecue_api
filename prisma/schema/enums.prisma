// ================================
// Subscription Related Enums
// ================================

enum PlanCode {
  PRO
}

enum SubscriptionStatus {
  FREE
  TRIAL
  PRO
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}


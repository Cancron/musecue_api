// ================================
// Privacy Related Enums
// ================================

enum DataExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum DataExportErrorCode {
  GENERATION_FAILED
  STORAGE_FULL
  ACCOUNT_UNAVAILABLE
  INTERRUPTED
  QUEUE_UNAVAILABLE
}

enum AccountDeletionStatus {
  // Accepted: the account is blocked and awaits erasure.
  PENDING
  PROCESSING
  COMPLETED
}

enum AccountDeletionVerification {
  // Legacy: password only (requests accepted before codes were required).
  PASSWORD
  // The account password and an emailed code.
  PASSWORD_AND_EMAIL_CODE
  // An emailed code (accounts without a password, e.g. Google sign-in).
  EMAIL_CODE
}

enum AccountDeletionFileKind {
  // One private image file (session photo, avatar or unreferenced file).
  PRIVATE_IMAGE
  // One export file: a generated archive or a temporary `.partial` file.
  EXPORT_FILE
  // Legacy (requests started before per-file cleanup): the owner's image
  // or export directory, resolved once the owner's files are all handled.
  IMAGE_OWNER_DIRECTORY
  EXPORT_OWNER_DIRECTORY
}

enum AccountDeletionFileOutcome {
  // Removed from private storage by the cleanup.
  DELETED
  // Already gone when the cleanup reached it.
  ALREADY_MISSING
  // Kept: another user's record references the same file.
  RETAINED_SHARED
  // Kept: the reference points outside the account's own storage scope.
  RETAINED_NOT_OWNED
}

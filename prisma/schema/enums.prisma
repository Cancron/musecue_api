// Status of a provider refund. Only SUCCEEDED refunds count towards the
// payment's refunded amount; the status only moves forward.
enum RefundStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

// One hosted checkout attempt with the payment provider. CREATING, OPEN and
// PROCESSING are pending: a user has at most one pending checkout (partial
// unique index). COMPLETED, EXPIRED and FAILED are terminal.
enum CheckoutSessionStatus {
  CREATING
  OPEN
  PROCESSING
  COMPLETED
  EXPIRED
  FAILED
}

// Processing state of a verified provider webhook event.
enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// ================================
// Privacy Related Enums
// ================================

enum DataExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum DataExportErrorCode {
  GENERATION_FAILED
  STORAGE_FULL
  ACCOUNT_UNAVAILABLE
  INTERRUPTED
  QUEUE_UNAVAILABLE
}

enum AccountDeletionStatus {
  // Accepted: the account is blocked and awaits erasure.
  PENDING
  PROCESSING
  COMPLETED
}

enum AccountDeletionVerification {
  // Legacy: password only (requests accepted before codes were required).
  PASSWORD
  // The account password and an emailed code.
  PASSWORD_AND_EMAIL_CODE
  // An emailed code (accounts without a password, e.g. Google sign-in).
  EMAIL_CODE
}

enum AccountDeletionFileKind {
  // One private image (session photo or avatar): an image storage key.
  PRIVATE_IMAGE
  // Every remaining file in the owner's image directory (`<authId>`),
  // including files no database row references any more.
  IMAGE_OWNER_DIRECTORY
  // Every remaining file in the owner's export directory (`<authId>`),
  // including partial (temporary) archives.
  EXPORT_OWNER_DIRECTORY
  // One generated export archive: an export storage key.
  EXPORT_ARCHIVE
}

enum AccountDeletionFileStatus {
  // Not yet deleted (or the last attempt failed; retried).
  PENDING
  // Deleted from storage.
  DELETED
  // Already absent from storage: nothing to delete.
  MISSING
  // Deliberately kept: another account references it, or it lies outside
  // the account's storage scope.
  RETAINED
}

// ================================
// Infrastructure Related Enums
// ================================

// State of a job in the PostgreSQL queue driver (REDIS_ENABLED=false).
// WAITING jobs run once `availableAt` has passed (a later `availableAt` is a
// delayed retry); ACTIVE jobs are leased by a worker.
enum InfrastructureJobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

// ================================
// AI Credit Related Enums
// ================================

// Where an allocation of credits came from. TRIAL and SUBSCRIPTION credits
// always expire; PURCHASE, REFERRAL and DAILY_REWARD credits never expire
// (CHECK constraint on CreditAllocation).
enum CreditSource {
  TRIAL
  SUBSCRIPTION
  PURCHASE
  REFERRAL
  // Daily reward claims (never expire; at most 600 per user and UTC month).
  DAILY_REWARD
  // Loyalty mission rewards (never expire; not part of the daily reward cap).
  MISSION_REWARD
  // Credit packages received as a gift (never expire; spent like purchased
  // credits).
  GIFT
}

// How often a loyalty mission can be completed: once ever, or once per UTC
// week (Monday to Sunday) or UTC calendar month.
enum LoyaltyMissionRecurrence {
  ONCE
  WEEKLY
  MONTHLY
}

// A CreditTransaction changes the available balance: GRANT adds an
// allocation, DEBIT consumes credits (and records any session overage),
// EXPIRATION removes the unused rest of an expired allocation.
enum CreditTransactionType {
  GRANT
  DEBIT
  EXPIRATION
}

// Progress of one scheduled month of Pro credits. Only moves forward:
// PENDING -> ALLOCATED (credits granted) or SKIPPED (not entitled any more,
// e.g. the payment was refunded or the paid term no longer covers it).
enum CreditScheduleStatus {
  PENDING
  ALLOCATED
  SKIPPED
}

// Whether an AI provider request produced the result of its run.
enum AiUsageOutcome {
  SUCCEEDED
  FAILED
}

// Credits for one AI provider request. Only moves forward from PENDING.
enum AiUsageChargeStatus {
  // Recorded; the run's result has not been published yet.
  PENDING
  // Deducted (see CreditTransaction).
  CHARGED
  // Not deducted: a failed or retried attempt, a discarded result, a run
  // already charged, or no cost (see chargeNote).
  NOT_CHARGED
  // Due but (partly) not collectible: the balance and the session's overage
  // allowance did not cover it.
  UNCOLLECTED
}

// ================================
// Credit Package Related Enums
// ================================

// The fixed set of purchasable credit packages, in display order.
enum CreditPackageCode {
  SMALL
  MEDIUM
  LARGE
}

// A credit package purchase. CREATING: stored, Stripe checkout not opened
// yet; OPEN: payable on the Stripe page; PROCESSING: paid with a delayed
// method that has not settled. PAID is final (credits granted); EXPIRED
// (abandoned), FAILED and CANCELED are closed (a verified late payment of
// a closed order still makes it PAID).
// Whether an order buys credits for the payer or a gift for someone else.
enum CreditPackageOrderKind {
  SELF
  GIFT
}

// A gift invitation: PENDING until the recipient accepts (ACCEPTED) or
// declines (DECLINED); EXPIRED if not accepted and paid in time; CANCELED by
// the sender before payment. Only an ACCEPTED gift can be paid (PAID); it is
// then DELIVERED at its delivery time, or held for REVIEW when the recipient
// cannot receive credits (an administrator delivers or REJECTS it).
enum CreditGiftStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
  PAID
  DELIVERED
  REVIEW
  REJECTED
}

// Granting the credits of a paid order. PENDING / RETRYING: due (at
// nextAttemptAt); SUCCEEDED: granted once; FAILED: attempts exhausted (an
// administrator retries); HELD: waiting for an administrator; REJECTED:
// never granted.
enum CreditFulfillmentStatus {
  PENDING
  RETRYING
  SUCCEEDED
  FAILED
  HELD
  REJECTED
}

enum CreditPackageOrderStatus {
  CREATING
  OPEN
  PROCESSING
  PAID
  EXPIRED
  FAILED
  CANCELED
}

// ================================
// Discount Offer Related Enums
// ================================

// A discount code is redeemed by entering its code; a campaign (e.g. a
// holiday promotion) has no code and is offered to every eligible user
// while it runs.
enum DiscountOfferKind {
  CODE
  CAMPAIGN
}

// Who may redeem an offer: everyone, or only the users listed in
// DiscountOfferTarget (nobody, if all of them have been deleted).
enum DiscountAudience {
  ALL_USERS
  SELECTED_USERS
}

// Where the discount of a redemption came from: the first-purchase or
// referral discount of DiscountSettings (no DiscountOffer), or an offer.
enum DiscountSource {
  FIRST_PURCHASE
  REFERRAL
  CODE
  CAMPAIGN
}

// RESERVED: held by an unpaid checkout (counts towards the limits and the
// budget); REDEEMED: paid for (or redeemed for a credit package); RELEASED:
// the checkout can no longer be paid, nothing is counted.
enum DiscountRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

// What a discount applies to: a Pro billing option or a credit package.
enum DiscountProduct {
  PRO_MONTHLY
  PRO_YEARLY
  CREDITS_SMALL
  CREDITS_MEDIUM
  CREDITS_LARGE
}

// Which customers may redeem an offer: everyone, users who never made a
// successful paid purchase, or users who did.
enum DiscountCustomerEligibility {
  ALL_CUSTOMERS
  NEW_CUSTOMERS
  RETURNING_CUSTOMERS
}

// A referral waits for the referred user's first verified paying purchase:
// REWARDED when the referrer received credits for it, QUALIFIED when it
// happened but no reward was due, HELD when it looks suspicious and waits
// for an administrator, REJECTED when the administrator refused it.
enum ReferralStatus {
  PENDING
  REWARDED
  QUALIFIED
  // Suspicious (e.g. a payment method shared with the referrer): the reward
  // waits for an administrator, who approves (REWARDED / QUALIFIED) or
  // rejects it.
  HELD
  REJECTED
}

// ================================
// Notification Related Enums
// ================================

enum NotificationType {
  REFERRAL_REWARD_EARNED
  REFERRAL_MILESTONE_REACHED
  // Security notifications: always emailed, whatever the preferences.
  SECURITY_SIGNED_OUT_EVERYWHERE
  SECURITY_SESSION_REUSE_DETECTED
  // Credit package gifts.
  GIFT_RECEIVED
  GIFT_ACCEPTED
  GIFT_DECLINED
  GIFT_DELIVERED
}

// Email delivery of one notification: NOT_REQUESTED when the user's
// preferences turned it off; PENDING until a worker claims it (SENDING),
// SENT once delivered, FAILED after the last attempt.
enum NotificationEmailStatus {
  NOT_REQUESTED
  PENDING
  SENDING
  SENT
  FAILED
}

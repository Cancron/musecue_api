// ================================
// Auth User Model
// ================================

model authUser {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  username     String     @unique
  role         userRole   @default(USER)
  verified     Boolean    @default(false)
  status       userStatus @default(ACTIVE)
  tokenVersion Int        @default(1) // For immediate JWT revocation on security events
  deletedAt    DateTime?
  provider     String     @default("local")
  providerId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  userProfile        userProfile?
  authSecurity       authSecurity?
  loginHistory       loginHistory[]
  emailHistory       emailHistory[]
  activityLogEvents  ActivityLogEvent[]
  makeupSessions     MakeupSession[]
  aiRuns             AiRun[]
  subscription       UserSubscription?
  dataExports        DataExport[]
  paymentCustomers   PaymentCustomer[]
  refreshSessions    RefreshSession[]
  authChallenges     AuthChallenge[]
  infrastructureJobs InfrastructureJob[]
  mfaEnrollment      MfaEnrollment?
  mfaRecoveryCodes   MfaRecoveryCode[]
  mfaLoginChallenges MfaLoginChallenge[]
  mfaTrustedDevices  MfaTrustedDevice[]

  @@index([email, id, providerId])
  @@index([username])
}

// ================================
// Auth Security Model
// ================================

model authSecurity {
  id                  String     @id @default(uuid())
  authId              String     @unique
  failedAttempts      Int        @default(0)
  lastFailedAt        DateTime?
  lockExpiresAt       DateTime?
  mfaEnabled          Boolean    @default(false)
  mfaMethod           mfaMethod?
  // Confirmed TOTP secret, encrypted with AES-256-GCM under the dedicated
  // MFA_ENCRYPTION_KEY and bound to the user (never stored in plaintext, never
  // dependent on a JWT secret). Set only when MFA is enabled.
  mfaSecret           String?
  // TOTP time step (Unix time / 30 s) of the last accepted authenticator
  // code: a code of this or an earlier step is never accepted again.
  mfaLastUsedStep     Int?
  // Incorrect MFA verification codes (authenticator or recovery code) of the
  // last 15 minutes (at most 5); the fifth sets `mfaBlockedUntil`.
  mfaFailedAttemptsAt DateTime[] @default([])
  mfaBlockedUntil     DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastPasswordChange  DateTime?

  // Relations
  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
}

// ================================
// MFA Enrollment Model
// ================================

// The owner's authenticator-app (TOTP) enrollment in progress, and the
// incorrect confirmation codes that can temporarily block it. At most one row
// per user. `secret` is the pending TOTP secret, encrypted with AES-256-GCM
// and bound to the user; it is usable until `expiresAt` (10 minutes) and is
// moved (re-encrypted) to authSecurity.mfaSecret when a correct code confirms
// it. Starting again replaces the secret but keeps the failure history, so a
// restart never clears a block. `failedAttemptsAt` keeps the incorrect codes
// of the last 15 minutes (at most 5); the fifth sets `blockedUntil`.
model MfaEnrollment {
  id               String     @id @default(uuid())
  authId           String     @unique
  secret           String?
  expiresAt        DateTime?
  failedAttemptsAt DateTime[] @default([])
  blockedUntil     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ================================
// MFA Recovery Code Model
// ================================

// One single-use recovery code of a user with MFA enabled, usable instead of
// an authenticator code. Ten are issued when MFA is enabled (and when the
// user regenerates them, which deletes all previous ones). The code itself is
// shown once and never stored: `codeHash` is a salted scrypt hash (one-way,
// no key involved) bound to the user, so another user's code never matches.
// `usedAt` records the consumption; a database trigger makes a used code
// permanent.
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  authId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId, usedAt])
}

// ================================
// MFA Login Challenge Model
// ================================

// The second step of a sign-in of a user with MFA enabled: after the password
// (or Google) step succeeds, the client receives an opaque challenge token
// instead of access and refresh tokens, and exchanges it, together with an
// authenticator or recovery code, at POST /auth/login/mfa. Only the SHA-256
// of the token is stored. A challenge expires after five minutes and is
// consumed by the first successful verification; it never authorizes
// anything else.
model MfaLoginChallenge {
  id         String    @id @default(uuid())
  authId     String
  tokenHash  String    @unique @db.Char(64)
  // The first factor that passed: local (password) or google.
  provider   String    @db.VarChar(32)
  ipAddress  String?
  userAgent  String?
  device     String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
  @@index([expiresAt])
}

// ================================
// MFA Trusted Device Model
// ================================

// A device the user chose to trust after completing MFA: for 30 days, a
// sign-in from it that presents its token (X-MFA-Trusted-Device) skips the
// MFA challenge. Only the SHA-256 of the token is stored. A device only ever
// counts for its own user, and stops counting when it expires or is revoked
// (a database trigger keeps owner, token and expiry unchangeable and a
// revocation permanent).
model MfaTrustedDevice {
  id         String    @id @default(uuid())
  authId     String
  tokenHash  String    @unique @db.Char(64)
  name       String    @db.VarChar(100)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId, revokedAt, expiresAt])
  @@index([expiresAt])
}

// ================================
// Refresh Session Model
// ================================

// One signed-in device: the refresh token issued at login and every token it
// was rotated into. Only the SHA-256 hash of a refresh token is stored, never
// the token. POST /auth/refresh-token revokes the presented session (ROTATED)
// and inserts its replacement in one transaction, so a refresh token works
// exactly once even under concurrent requests. `rotatedFromId` records the
// rotation lineage. Rows are removed by the cleanup sweep after `expiresAt`.
model RefreshSession {
  id            String                    @id @default(uuid())
  authId        String
  // The refresh token's JWT ID (`jti`).
  tokenId       String                    @unique @db.VarChar(128)
  // SHA-256 (hex) of the complete refresh token.
  tokenHash     String                    @db.Char(64)
  ipAddress     String?
  userAgent     String?
  device        String?
  rotatedFromId String?                   @unique
  createdAt     DateTime                  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RefreshSessionRevocation?

  authUser    authUser        @relation(fields: [authId], references: [id], onDelete: Cascade)
  rotatedFrom RefreshSession? @relation("RefreshSessionRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   RefreshSession? @relation("RefreshSessionRotation")

  @@index([authId, revokedAt, expiresAt])
  @@index([expiresAt])
}

// ================================
// Auth Challenge Model
// ================================

// A one-time code emailed to a user (email verification, account deletion
// confirmation). Only a purpose-bound HMAC of the code is stored. A user has
// at most one challenge per purpose: issuing a new code replaces the previous
// one and resets its attempts. A challenge accepts `maxAttempts` guesses, then
// stops working; a correct code is consumed (`consumedAt`) and never works
// again.
model AuthChallenge {
  id          String               @id @default(uuid())
  authId      String
  purpose     AuthChallengePurpose
  // HMAC-SHA-256 (hex) of the purpose, user and code.
  codeHash    String               @db.Char(64)
  attempts    Int                  @default(0)
  maxAttempts Int
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  authUser authUser @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([authId, purpose])
  @@index([expiresAt])
}

// ================================
// OAuth State Model
// ================================

// The CSRF `state` of an OAuth authorization in progress, with its PKCE code
// verifier and redirect target. The state is stored only as a hash and the
// rest is encrypted (AES-256-GCM). A state is consumed (deleted) by the first
// callback that presents it and expires after ten minutes.
model OAuthState {
  id        String   @id @default(uuid())
  provider  String   @db.VarChar(32)
  // SHA-256 (hex) of the state parameter.
  stateHash String   @unique @db.Char(64)
  // Encrypted JSON: PKCE code verifier, redirect URL and request metadata.
  payload   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
